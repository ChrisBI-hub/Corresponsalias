# Copia este archivo como ".env" (sin el ".example") en la misma carpeta
# del proyecto, en la máquina donde se va a ejecutar main.py, y llena los
# valores reales. El ".env" NO se sube a git (ver .gitignore).

# Ruta base del proyecto en la máquina donde corre (dentro de esta carpeta
# se crea _tmp_descargas/ y faltantes_sanofi_mexico.txt — se quedan siempre
# en disco local, nunca en red).
PROYECTO_BASE=/home/christian/Documentos/Corresponsalias

# Carpeta final de Descargas (y de _debug/, junto a Descargas). Opcional:
# si no se define, ambas quedan en PROYECTO_BASE/Descargas (disco local).
# Para guardar en el recurso de red \\10.10.10.97\corresponsal_Efile,
# monta ese share localmente (ver README, sección "Descargas en el recurso
# de red") y apunta aquí al punto de montaje:
# RUTA_DESCARGAS=/mnt/corresponsal

# --- SQL Server (SIR) — consulta de referencias ---
SIR_SQL_SERVER=150.1.1.152
SIR_SQL_DATABASE=SIR
SIR_SQL_USER=ConsultaBD
SIR_SQL_PASS=

# Base de control de descargas (mismo servidor/usuario/contraseña de
# arriba, solo cambia la base). Opcional: si no se define, se usa "BI".
# BI_SQL_DATABASE=BI

# --- Portal Laredo (SLAM.Digital) — una cuenta por razón social ---
LAREDO_PASTEUR_USER=PASTEUR
LAREDO_PASTEUR_PASS=

LAREDO_AZVA2025_USER=AZVA2025
LAREDO_AZVA2025_PASS=

LAREDO_AVENTIS_USER=AVENTIS
LAREDO_AVENTIS_PASS=

LAREDO_BIP2021_USER=BIP2021
LAREDO_BIP2021_PASS=

# --- Portal Manzanillo (OWCIA) — cuenta única, acceso general ---
OWCIA_USER=ABSOLUTE
OWCIA_PASS=
